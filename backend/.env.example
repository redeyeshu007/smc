# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:3000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/smc_showroom
MONGODB_DB_NAME=smc_showroom

# Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars!
JWT_EXPIRES_IN=7d

# Initial Admin Account (Seeding)
ADMIN_NAME=SMC Admin
ADMIN_EMAIL=javix@gmail.com
ADMIN_PASSWORD=javix2026

# Cloudflare R2 / AWS S3 Compatible Object Storage
STORAGE_PROVIDER=r2
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=your_r2_or_s3_access_key
S3_SECRET_ACCESS_KEY=your_r2_or_s3_secret_key
S3_BUCKET_NAME=smc-3d-assets
S3_PUBLIC_DOMAIN=https://assets.yourshowroomdomain.com

# File Upload Constraints
MAX_FILE_SIZE_MB=50
MAX_IMAGE_SIZE_MB=10
